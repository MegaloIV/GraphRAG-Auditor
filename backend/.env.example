# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000

# ── Groq (extracción rápida) ─────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenAI (auditoría + RAGAS + embeddings) ──────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── CrossRef / Unpaywall ─────────────────────────────────────────────────────
CROSSREF_EMAIL=

# API académica de texto completo (gratuita, con cuota diaria).
# CORE: https://core.ac.uk/services/api  (~500 peticiones/día)
CORE_API_KEY=

# ── Neo4j (grafo de conocimiento) ────────────────────────────────────────────
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ── Supabase Postgres (pgvector: tabla papers_chunks + auditoria_progreso) ───
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# ── Supabase Storage (PDFs, markdown, resultados) ────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=graphrag-auditor

# ── Ingesta ──────────────────────────────────────────────────────────────────
MAX_PDF_SIZE_MB=10

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Google Drive (opcional) ─────────────────────────────────
# Copia de respaldo de los papers descargados, organizada por tesis.
# Si se deja vacío, el sistema no sube nada y funciona igual.
# El id sale de la URL de la carpeta: /folders/<ID>
GOOGLE_DRIVE_CARPETA_ID=
# Rutas de las credenciales OAuth (ver scripts/autorizar_drive.py).
GOOGLE_OAUTH_CREDENCIALES=../Keys/google_oauth.json
GOOGLE_OAUTH_TOKEN=../Keys/google_drive_token.json
